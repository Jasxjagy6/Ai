// Aria AI — database schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum PlanTier {
  FREE
  PLUS
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          Role      @default(USER)
  emailVerified DateTime?
  image         String?
  banned        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscription         Subscription?
  payments             Payment[]
  conversations        Conversation[]
  usage                UsageLog[]
  apiKeys              ApiKey[]
  validatorKeysCreated ValidatorAccessKey[] @relation("ValidatorKeyCreator")
}

model ApiKey {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String     @unique // sha256 of the full key
  prefix     String // first chars shown in dashboard (aria_sk_xxxx...)
  revoked    Boolean    @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime   @default(now())
  usage      ApiUsage[]

  @@index([userId])
}

model ApiUsage {
  id       String   @id @default(cuid())
  apiKeyId String
  apiKey   ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  day      DateTime @db.Date
  requests Int      @default(0)

  @@unique([apiKeyId, day])
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier              PlanTier           @default(FREE)
  status            SubscriptionStatus @default(ACTIVE)
  provider          PaymentProvider?
  providerSubId     String? // razorpay subscription id / stripe subscription id
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Payment {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        PaymentProvider
  providerOrderId String          @unique
  providerPayId   String?
  amount          Int // smallest currency unit
  currency        String
  tier            PlanTier
  status          PaymentStatus   @default(CREATED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  personaId String?
  persona   Persona?  @relation(fields: [personaId], references: [id], onDelete: SetNull)
  title     String    @default("New chat")
  tone      String    @default("default") // user-picked vibe: default|funny|flirty|deep|poetic|supportive|adventurous
  language  String    @default("auto") // reply language: auto|en|es|fr|de|hi|pt|it|...
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  kind           String       @default("text") // text | voice | image
  audioPath      String? // voice note wav under uploads/, served via authed route
  imagePath      String? // user-uploaded image (vision) under uploads/
  mediaId        String?
  media          MediaAsset?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Persona engine: multiple AI companions, each with a personality, photo
// vault, and per-user long-term memory.
// ---------------------------------------------------------------------------

enum MediaCategory {
  SELFIE // "what do you look like", verification-style asks
  CASUAL // everyday life shots
  MORNING // morning context
  NIGHT // evening/night context
  ACTIVITY // hobby/outing shots
  MOOD // emotive
}

model Persona {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  tagline       String         @default("")
  age           Int            @default(24)
  systemPrompt  String
  chatStyle     String         @default("youthful") // youthful | mature
  voice         String         @default("amy") // Piper voice name for TTS voice notes
  avatarUrl     String         @default("/aria/avatar.svg")
  isDefault     Boolean        @default(false)
  active        Boolean        @default(true)
  minTier       PlanTier       @default(FREE) // gate premium personas
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  media         MediaAsset[]
  conversations Conversation[]
  memories      UserMemory[]
}

model MediaAsset {
  id          String        @id @default(cuid())
  personaId   String
  persona     Persona       @relation(fields: [personaId], references: [id], onDelete: Cascade)
  category    MediaCategory
  description String        @default("") // lets the AI reference what's in the photo
  path        String // stored under uploads/, served via authenticated route
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  messages    Message[]

  @@index([personaId, category])
}

/// Long-term facts a persona remembers about a user, extracted from chats.
model UserMemory {
  id        String   @id @default(cuid())
  userId    String
  personaId String
  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  fact      String
  createdAt DateTime @default(now())

  @@index([userId, personaId])
}

model UsageLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day      DateTime @db.Date
  messages Int      @default(0)

  @@unique([userId, day])
}

// Admin-editable runtime settings (model name, system prompt, limits, plans)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Newsletter / "be the first to know" email capture from the landing page.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// "What's New" changelog entries, admin-authored, shown on /changelog.
model Changelog {
  id        String   @id @default(cuid())
  title     String
  body      String
  tag       String   @default("New") // New | Improved | Fixed | Security
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

// Imported Telegram contact lists and durable, sessionless t.me checks.
model ValidatorAccount {
  id                       String                         @id @default(cuid())
  email                    String                         @unique
  active                   Boolean                        @default(true)
  creditsBalance           Int                            @default(0)
  creditsPurchased         Int                            @default(0)
  creditsSpent             Int                            @default(0)
  currentPlanCode          String?                        @db.VarChar(40)
  planExpiresAt            DateTime?
  lastCreditTopupAt        DateTime?
  referralCode             String?                        @unique @db.VarChar(20)
  referredById             String?
  referredBy               ValidatorAccount?              @relation("ValidatorReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals                ValidatorAccount[]             @relation("ValidatorReferrals")
  affiliateRateBps         Int?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  keys                     ValidatorAccessKey[]
  sessions                 ValidatorSession[]
  lists                    ContactList[]
  jobs                     LinkFilterJob[]
  purchases                ValidatorPurchase[]
  creditTransactions       ValidatorCreditTransaction[]
  affiliateRewardsEarned   ValidatorAffiliateReward[]     @relation("AffiliateReferrer")
  affiliateRewardsReceived ValidatorAffiliateReward[]     @relation("AffiliateCustomer")
  telegramCredential       TelegramApiCredential?
  telegramSessions         TelegramSession[]
  telegramSessionLists     TelegramSessionList[]
  telegramLoginFlows       TelegramLoginFlow[]
  telegramCampaigns        TelegramCampaign[]
  telegramSchedules        TelegramMessageSchedule[]
  telegramBehaviorLogs     TelegramBehaviorLog[]
  aiAccountSetting         AiAccountSetting?
  aiProviderCredentials    AiProviderCredential[]
  aiSessionSettings        AiSessionSetting[]
  aiChatSettings           AiChatSetting[]
  aiChatMemories           AiChatMemory[]
  aiChatJobs               AiChatJob[]
  aiResponseLogs           AiResponseLog[]
  aiCampaigns              AiCampaign[]
  accountSettingsBatches   TelegramAccountSettingsBatch[]
  accountSettingsJobs      TelegramAccountSettingsJob[]
  telegramClientCommands   TelegramClientCommand[]
  telegramTrial            ValidatorTelegramTrial?

  @@index([referredById])
}

model ValidatorAccessKey {
  id                  String                       @id @default(cuid())
  accountId           String
  account             ValidatorAccount             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdById         String?
  createdBy           User?                        @relation("ValidatorKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  label               String                       @default("Primary key") @db.VarChar(80)
  keyHash             String                       @unique
  prefix              String                       @db.VarChar(24)
  revoked             Boolean                      @default(false)
  expiresAt           DateTime?
  lastUsedAt          DateTime?
  createdAt           DateTime                     @default(now())
  requestLimit        Int?
  requestsUsed        Int                          @default(0)
  planCode            String?                      @db.VarChar(40)
  validatorAccess     Boolean                      @default(true)
  messagingAccess     Boolean                      @default(false)
  sessionLimit        Int?
  messageLimit        Int?
  messagesUsed        Int                          @default(0)
  purchases           ValidatorPurchase[]
  sessions            ValidatorSession[]
  messagingCampaigns  TelegramCampaign[]
  messagingSchedules  TelegramMessageSchedule[]
  messagingLoginFlows TelegramLoginFlow[]
  creditTransactions  ValidatorCreditTransaction[]
  telegramTrial       ValidatorTelegramTrial?

  @@index([accountId, createdAt])
}

model ValidatorPurchase {
  id              String                    @id @default(cuid())
  accountId       String
  account         ValidatorAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessKeyId     String?
  accessKey       ValidatorAccessKey?       @relation(fields: [accessKeyId], references: [id], onDelete: SetNull)
  email           String                    @db.VarChar(254)
  planCode        String                    @db.VarChar(40)
  planName        String                    @db.VarChar(80)
  purchaseType    String                    @default("plan") @db.VarChar(20)
  creditsAmount   Int                       @default(0)
  referralCode    String?                   @db.VarChar(20)
  status          String                    @default("created") @db.VarChar(24)
  provider        String                    @default("oxapay") @db.VarChar(30)
  providerTrackId String?                   @unique @db.VarChar(120)
  amountUsdCents  Int                       @default(0)
  durationDays    Int?
  requestLimit    Int?
  validatorAccess Boolean                   @default(true)
  messagingAccess Boolean                   @default(false)
  sessionLimit    Int?
  messageLimit    Int?
  claimTokenHash  String                    @unique @db.VarChar(64)
  paymentUrl      String?
  paidAt          DateTime?
  claimedAt       DateTime?
  fulfilledAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  affiliateReward ValidatorAffiliateReward?

  @@index([email, createdAt])
  @@index([status, createdAt])
  @@index([accessKeyId])
}

model ValidatorTelegramTrial {
  id                String              @id @default(cuid())
  telegramUserId    BigInt              @unique
  telegramUsername  String?             @db.VarChar(100)
  telegramFirstName String?             @db.VarChar(100)
  telegramLastName  String?             @db.VarChar(100)
  accountId         String              @unique
  account           ValidatorAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessKeyId       String              @unique
  accessKey         ValidatorAccessKey  @relation(fields: [accessKeyId], references: [id], onDelete: Cascade)
  creditsGranted    Int                 @default(2500)
  claimedAt         DateTime            @default(now())
  expiresAt         DateTime

  @@index([expiresAt])
}

model ValidatorCreditTransaction {
  id            String              @id @default(cuid())
  accountId     String
  account       ValidatorAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessKeyId   String?
  accessKey     ValidatorAccessKey? @relation(fields: [accessKeyId], references: [id], onDelete: SetNull)
  amount        Int
  balanceAfter  Int
  kind          String              @db.VarChar(30)
  taskCode      String?             @db.VarChar(60)
  description   String              @db.VarChar(220)
  referenceType String?             @db.VarChar(40)
  referenceId   String?             @db.VarChar(120)
  metadata      Json?
  createdAt     DateTime            @default(now())

  @@index([accountId, createdAt])
  @@index([referenceType, referenceId])
}

model ValidatorAffiliateReward {
  id                String            @id @default(cuid())
  referrerId        String
  referrer          ValidatorAccount  @relation("AffiliateReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredAccountId String
  referredAccount   ValidatorAccount  @relation("AffiliateCustomer", fields: [referredAccountId], references: [id], onDelete: Cascade)
  purchaseId        String            @unique
  purchase          ValidatorPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  rateBps           Int
  depositUsdCents   Int
  rewardCredits     Int
  status            String            @default("credited") @db.VarChar(20)
  createdAt         DateTime          @default(now())

  @@index([referrerId, createdAt])
  @@index([referredAccountId, createdAt])
}

model ValidatorUpdate {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(160)
  body        String
  tag         String   @default("Update") @db.VarChar(30)
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt])
}

model ValidatorSession {
  id          String              @id @default(cuid())
  accountId   String
  account     ValidatorAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessKeyId String?
  accessKey   ValidatorAccessKey? @relation(fields: [accessKeyId], references: [id], onDelete: SetNull)
  tokenHash   String              @unique
  expiresAt   DateTime
  lastSeenAt  DateTime            @default(now())
  createdAt   DateTime            @default(now())

  @@index([accountId, expiresAt])
  @@index([accessKeyId])
  @@index([expiresAt])
}

model ContactList {
  id                String                    @id @default(cuid())
  accountId         String
  account           ValidatorAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name              String                    @db.VarChar(255)
  type              String                    @default("users") @db.VarChar(20)
  itemsCount        Int                       @default(0)
  source            String?                   @db.VarChar(100)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  items             ListItem[]
  sourceJobs        LinkFilterJob[]           @relation("LinkFilterSourceList")
  resultJobs        LinkFilterJob[]           @relation("LinkFilterResultList")
  telegramCampaigns TelegramCampaign[]        @relation("TelegramCampaignSourceList")
  telegramSchedules TelegramMessageSchedule[] @relation("TelegramScheduleSourceList")

  @@index([accountId, createdAt])
}

model ListItem {
  id           String           @id @default(cuid())
  listId       String
  list         ContactList      @relation(fields: [listId], references: [id], onDelete: Cascade)
  telegramId   BigInt?
  username     String?          @db.VarChar(100)
  firstName    String?          @db.VarChar(100)
  lastName     String?          @db.VarChar(100)
  phone        String?          @db.VarChar(30)
  accessHash   BigInt?
  bio          String?          @db.VarChar(70)
  addedAt      DateTime         @default(now())
  sourceChecks LinkFilterItem[]

  @@index([listId, addedAt])
  @@index([listId, telegramId])
  @@index([listId, username])
}

model LinkFilterJob {
  id                 String           @id @default(cuid())
  accountId          String
  account            ValidatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sourceListId       String?
  sourceList         ContactList?     @relation("LinkFilterSourceList", fields: [sourceListId], references: [id], onDelete: SetNull)
  resultListId       String?
  resultList         ContactList?     @relation("LinkFilterResultList", fields: [resultListId], references: [id], onDelete: SetNull)
  sourceListName     String           @db.VarChar(255)
  resultListName     String           @db.VarChar(255)
  status             String           @default("pending") @db.VarChar(20)
  sourceItemsCount   Int              @default(0)
  totalCount         Int              @default(0)
  processedCount     Int              @default(0)
  validCount         Int              @default(0)
  invalidCount       Int              @default(0)
  failedCount        Int              @default(0)
  skippedCount       Int              @default(0)
  ignoredCount       Int              @default(0)
  duplicateCount     Int              @default(0)
  currentUsername    String?          @db.VarChar(100)
  currentPass        Int              @default(0)
  maxPasses          Int              @default(1)
  passProcessedCount Int              @default(0)
  passTotalCount     Int              @default(0)
  totalRequests      Int              @default(0)
  creditsCharged     Int              @default(0)
  timedOut           Boolean          @default(false)
  cancelRequested    Boolean          @default(false)
  useProxies         Boolean          @default(true)
  errorMessage       String?
  createdAt          DateTime         @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  lastProgressAt     DateTime         @default(now())
  items              LinkFilterItem[]

  @@index([accountId, createdAt])
  @@index([status, createdAt])
  @@index([sourceListId])
  @@index([resultListId])
}

model LinkFilterItem {
  id                 String        @id @default(cuid())
  jobId              String
  job                LinkFilterJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceListItemId   String?
  sourceListItem     ListItem?     @relation(fields: [sourceListItemId], references: [id], onDelete: SetNull)
  username           String        @db.VarChar(100)
  normalizedUsername String        @db.VarChar(100)
  status             String        @default("pending") @db.VarChar(20)
  displayName        String?       @db.VarChar(100)
  attempts           Int           @default(0)
  errorCode          String?       @db.VarChar(80)
  errorMessage       String?
  createdAt          DateTime      @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?

  @@unique([jobId, normalizedUsername])
  @@index([jobId, status, createdAt])
  @@index([sourceListItemId])
}

model TelegramApiCredential {
  id               String              @id @default(cuid())
  accountId        String              @unique
  account          ValidatorAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  label            String              @default("Telegram API") @db.VarChar(80)
  apiId            Int
  apiHashEncrypted String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  sessions         TelegramSession[]
  loginFlows       TelegramLoginFlow[]
}

model TelegramSession {
  id                      String                       @id @default(cuid())
  accountId               String
  account                 ValidatorAccount             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  credentialId            String
  credential              TelegramApiCredential        @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  label                   String                       @db.VarChar(100)
  phone                   String?                      @db.VarChar(30)
  username                String?                      @db.VarChar(100)
  firstName               String?                      @db.VarChar(100)
  lastName                String?                      @db.VarChar(100)
  profileBio              String?                      @db.VarChar(255)
  avatarData              Bytes?
  avatarMime              String?                      @db.VarChar(50)
  isPremium               Boolean                      @default(false)
  isVerified              Boolean                      @default(false)
  isRestricted            Boolean                      @default(false)
  profileSyncedAt         DateTime?
  profileSyncRequested    Boolean                      @default(true)
  profileSyncClaimedAt    DateTime?
  telegramUserId          BigInt?
  sessionDataEncrypted    String
  sessionFingerprint      String                       @db.VarChar(64)
  sessionFormat           String                       @default("session_string") @db.VarChar(30)
  sourceFilename          String?                      @db.VarChar(255)
  status                  String                       @default("uploaded") @db.VarChar(30)
  isLoggedIn              Boolean                      @default(false)
  hasTwoFactor            Boolean                      @default(false)
  antiDetectEnabled       Boolean                      @default(true)
  deviceIdentity          Json?
  proxyEncrypted          String?
  proxyLabel              String?                      @db.VarChar(100)
  proxyEnabled            Boolean                      @default(false)
  riskScore               Float                        @default(0)
  spamStatus              String                       @default("unknown") @db.VarChar(30)
  spamLimitUntil          DateTime?
  spamCheckedAt           DateTime?
  spamStatusMessage       String?
  spamCheckRequested      Boolean                      @default(true)
  spamCheckClaimedAt      DateTime?
  healthCooldownUntil     DateTime?
  consecutiveFloodWaits   Int                          @default(0)
  lastFloodSeconds        Int                          @default(0)
  lastFloodAt             DateTime?
  consecutiveSendFailures Int                          @default(0)
  warmupEnabled           Boolean                      @default(true)
  warmupMode              String                       @default("safe") @db.VarChar(20)
  warmupStartedAt         DateTime                     @default(now())
  warmupCompletedAt       DateTime?
  lastWarmupAt            DateTime?
  warmupActions           Int                          @default(0)
  warmupRequested         Boolean                      @default(false)
  warmupClaimedAt         DateTime?
  dailyMessagesSent       Int                          @default(0)
  dailyMessagesResetAt    DateTime                     @default(now())
  lastErrorCode           String?                      @db.VarChar(100)
  lastErrorMessage        String?
  lastLoginAt             DateTime?
  lastActiveAt            DateTime?
  messagesSent            Int                          @default(0)
  repliesReceived         Int                          @default(0)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  listMemberships         TelegramSessionListMember[]
  campaignAssignments     TelegramCampaignSession[]
  recipients              TelegramCampaignRecipient[]
  behaviorLogs            TelegramBehaviorLog[]
  aiSetting               AiSessionSetting?
  aiChatSettings          AiChatSetting[]
  aiMemories              AiChatMemory[]
  aiJobs                  AiChatJob[]
  aiResponseLogs          AiResponseLog[]
  aiCampaignMemberships   AiCampaignSession[]
  accountSettingsJobs     TelegramAccountSettingsJob[]
  clientCommands          TelegramClientCommand[]

  @@unique([accountId, sessionFingerprint])
  @@index([accountId, createdAt])
  @@index([accountId, status])
  @@index([credentialId])
  @@index([spamStatus, spamLimitUntil])
  @@index([healthCooldownUntil])
  @@index([warmupEnabled, lastWarmupAt])
  @@index([spamCheckRequested, spamCheckClaimedAt])
  @@index([warmupRequested, warmupClaimedAt])
  @@index([profileSyncRequested, profileSyncClaimedAt])
}

model TelegramSessionList {
  id          String                      @id @default(cuid())
  accountId   String
  account     ValidatorAccount            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String                      @db.VarChar(120)
  description String?                     @db.VarChar(500)
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  members     TelegramSessionListMember[]

  @@unique([accountId, name])
  @@index([accountId, createdAt])
}

model TelegramSessionListMember {
  listId    String
  sessionId String
  list      TelegramSessionList @relation(fields: [listId], references: [id], onDelete: Cascade)
  session   TelegramSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  position  Int                 @default(0)
  addedAt   DateTime            @default(now())

  @@id([listId, sessionId])
  @@index([sessionId])
}

model TelegramAccountSettingsBatch {
  id              String                       @id @default(cuid())
  accountId       String
  account         ValidatorAccount             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind            String                       @db.VarChar(40)
  status          String                       @default("pending") @db.VarChar(20)
  totalCount      Int                          @default(0)
  processedCount  Int                          @default(0)
  succeededCount  Int                          @default(0)
  failedCount     Int                          @default(0)
  skippedCount    Int                          @default(0)
  cancelRequested Boolean                      @default(false)
  metadata        Json?
  errorMessage    String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  jobs            TelegramAccountSettingsJob[]

  @@index([accountId, createdAt])
  @@index([status, createdAt])
}

model TelegramAccountSettingsJob {
  id           String                       @id @default(cuid())
  batchId      String
  batch        TelegramAccountSettingsBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  accountId    String
  account      ValidatorAccount             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sessionId    String
  session      TelegramSession              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  action       String                       @db.VarChar(40)
  status       String                       @default("pending") @db.VarChar(20)
  position     Int                          @default(0)
  payload      Json?
  result       Json?
  errorCode    String?                      @db.VarChar(100)
  errorMessage String?
  attempts     Int                          @default(0)
  claimedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  @@index([status, createdAt])
  @@index([batchId, status, position])
  @@index([accountId, createdAt])
  @@index([sessionId, createdAt])
}

model TelegramClientCommand {
  id           String           @id @default(cuid())
  accountId    String
  account      ValidatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sessionId    String
  session      TelegramSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind         String           @db.VarChar(50)
  status       String           @default("pending") @db.VarChar(20)
  payload      Json?
  result       Json?
  resultData   Bytes?
  resultMime   String?          @db.VarChar(100)
  resultName   String?          @db.VarChar(255)
  errorCode    String?          @db.VarChar(100)
  errorMessage String?
  attempts     Int              @default(0)
  expiresAt    DateTime
  claimedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([accountId, sessionId, createdAt])
  @@index([expiresAt])
}

model TelegramLoginFlow {
  id                     String                @id @default(cuid())
  accountId              String
  account                ValidatorAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessKeyId            String?
  accessKey              ValidatorAccessKey?   @relation(fields: [accessKeyId], references: [id], onDelete: SetNull)
  credentialId           String
  credential             TelegramApiCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  phone                  String                @db.VarChar(30)
  label                  String                @db.VarChar(100)
  status                 String                @default("pending_code") @db.VarChar(30)
  codeEncrypted          String?
  passwordEncrypted      String?
  phoneCodeHashEncrypted String?
  sessionDataEncrypted   String?
  deviceIdentity         Json?
  proxyEncrypted         String?
  errorCode              String?               @db.VarChar(100)
  errorMessage           String?
  sessionId              String?
  expiresAt              DateTime
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([accountId, createdAt])
  @@index([accessKeyId])
  @@index([status, updatedAt])
}

model TelegramCampaign {
  id                      String                      @id @default(cuid())
  accountId               String
  account                 ValidatorAccount            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessKeyId             String?
  accessKey               ValidatorAccessKey?         @relation(fields: [accessKeyId], references: [id], onDelete: SetNull)
  sourceListId            String?
  sourceList              ContactList?                @relation("TelegramCampaignSourceList", fields: [sourceListId], references: [id], onDelete: SetNull)
  scheduleId              String?
  schedule                TelegramMessageSchedule?    @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  name                    String                      @db.VarChar(160)
  targetType              String                      @default("users") @db.VarChar(20)
  mode                    String                      @default("balanced") @db.VarChar(30)
  message                 String
  parseMode               String                      @default("text") @db.VarChar(20)
  status                  String                      @default("pending") @db.VarChar(30)
  totalCount              Int                         @default(0)
  processedCount          Int                         @default(0)
  sentCount               Int                         @default(0)
  failedCount             Int                         @default(0)
  skippedCount            Int                         @default(0)
  repliedCount            Int                         @default(0)
  sessionCount            Int                         @default(0)
  reservedMessages        Int                         @default(0)
  quotaSettled            Boolean                     @default(false)
  reservedCredits         Int                         @default(0)
  creditItemCost          Int                         @default(0)
  creditsSettled          Boolean                     @default(false)
  configuration           Json?
  trackReplies            Boolean                     @default(true)
  replyWindowHours        Int                         @default(24)
  replyTrackingStatus     String                      @default("pending") @db.VarChar(30)
  replyTrackingUntil      DateTime?
  replyTrackingLastScanAt DateTime?
  cancelRequested         Boolean                     @default(false)
  currentTarget           String?                     @db.VarChar(150)
  errorMessage            String?
  createdAt               DateTime                    @default(now())
  startedAt               DateTime?
  finishedAt              DateTime?
  lastProgressAt          DateTime                    @default(now())
  sessions                TelegramCampaignSession[]
  recipients              TelegramCampaignRecipient[]
  behaviorLogs            TelegramBehaviorLog[]

  @@index([accountId, createdAt])
  @@index([status, createdAt])
  @@index([replyTrackingStatus, replyTrackingUntil])
  @@index([scheduleId])
  @@index([sourceListId])
}

model TelegramCampaignSession {
  campaignId       String
  sessionId        String
  campaign         TelegramCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  session          TelegramSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  position         Int              @default(0)
  status           String           @default("pending") @db.VarChar(30)
  assignedCount    Int              @default(0)
  sentCount        Int              @default(0)
  failedCount      Int              @default(0)
  lastErrorCode    String?          @db.VarChar(100)
  lastErrorMessage String?
  retiredAt        DateTime?

  @@id([campaignId, sessionId])
  @@index([sessionId])
}

model TelegramCampaignRecipient {
  id             String           @id @default(cuid())
  campaignId     String
  campaign       TelegramCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sessionId      String?
  session        TelegramSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  targetKey      String           @db.VarChar(220)
  targetInput    String           @db.VarChar(220)
  username       String?          @db.VarChar(100)
  telegramId     BigInt?
  accessHash     BigInt?
  phone          String?          @db.VarChar(30)
  displayName    String?          @db.VarChar(180)
  peerId         BigInt?
  status         String           @default("pending") @db.VarChar(30)
  attempts       Int              @default(0)
  messageId      BigInt?
  errorCode      String?          @db.VarChar(100)
  errorMessage   String?
  sentAt         DateTime?
  replied        Boolean          @default(false)
  repliedAt      DateTime?
  replyMessageId BigInt?
  replyPreview   String?          @db.VarChar(500)
  lastCheckedAt  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([campaignId, targetKey])
  @@index([campaignId, status, createdAt])
  @@index([sessionId, sentAt])
  @@index([campaignId, replied])
}

model TelegramBehaviorLog {
  id           String            @id @default(cuid())
  accountId    String
  account      ValidatorAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      TelegramSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  campaignId   String?
  campaign     TelegramCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  action       String            @db.VarChar(64)
  target       String?           @db.VarChar(220)
  succeeded    Boolean           @default(true)
  severity     String            @default("info") @db.VarChar(16)
  errorCode    String?           @db.VarChar(100)
  errorMessage String?
  details      Json?
  performedAt  DateTime          @default(now())

  @@index([accountId, performedAt])
  @@index([sessionId, performedAt])
  @@index([campaignId, performedAt])
  @@index([severity, performedAt])
}

model TelegramMessageSchedule {
  id              String              @id @default(cuid())
  accountId       String
  account         ValidatorAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessKeyId     String?
  accessKey       ValidatorAccessKey? @relation(fields: [accessKeyId], references: [id], onDelete: SetNull)
  sourceListId    String?
  sourceList      ContactList?        @relation("TelegramScheduleSourceList", fields: [sourceListId], references: [id], onDelete: SetNull)
  name            String              @db.VarChar(160)
  targetType      String              @default("groups") @db.VarChar(20)
  mode            String              @default("balanced") @db.VarChar(30)
  message         String
  parseMode       String              @default("text") @db.VarChar(20)
  sessionIds      Json
  manualTargets   Json?
  configuration   Json?
  intervalMinutes Int
  status          String              @default("active") @db.VarChar(30)
  runCount        Int                 @default(0)
  nextRunAt       DateTime
  lastRunAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  campaigns       TelegramCampaign[]

  @@index([accountId, createdAt])
  @@index([accessKeyId])
  @@index([status, nextRunAt])
  @@index([sourceListId])
}

// Signal Desk AI Chatter. Provider secrets are encrypted with the same
// server-side AES-GCM key used for Telegram credentials and never serialized.
model AiAccountSetting {
  id              String           @id @default(cuid())
  accountId       String           @unique
  account         ValidatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  enabled         Boolean          @default(false)
  reengageEnabled Boolean          @default(true)
  config          Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model AiProviderCredential {
  id              String           @id @default(cuid())
  accountId       String
  account         ValidatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  provider        String           @db.VarChar(30)
  secretEncrypted String
  isValid         Boolean          @default(false)
  modelId         Int?
  presetId        Int?
  catalog         Json?
  lastValidatedAt DateTime?
  validationError String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([accountId, provider])
  @@index([accountId, updatedAt])
}

model AiSessionSetting {
  id               String           @id @default(cuid())
  accountId        String
  account          ValidatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sessionId        String           @unique
  session          TelegramSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enabled          Boolean          @default(false)
  config           Json?
  runtimeStatus    String           @default("stopped") @db.VarChar(30)
  lastConnectedAt  DateTime?
  lastHeartbeatAt  DateTime?
  lastError        String?
  catchupRequested Boolean          @default(false)
  catchupClaimedAt DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([accountId, enabled])
  @@index([enabled, runtimeStatus])
  @@index([catchupRequested, catchupClaimedAt])
}

model AiCampaign {
  id                   String              @id @default(cuid())
  accountId            String
  account              ValidatorAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name                 String              @db.VarChar(160)
  provider             String              @db.VarChar(30)
  secretEncrypted      String
  credentialValid      Boolean             @default(true)
  modelId              Int?
  presetId             Int?
  catalog              Json?
  config               Json
  reengageEnabled      Boolean             @default(true)
  durationMode         String              @default("until_stopped") @db.VarChar(30)
  status               String              @default("starting") @db.VarChar(30)
  messagesReceived     Int                 @default(0)
  messagesSent         Int                 @default(0)
  failedCount          Int                 @default(0)
  creditsUsed          Int                 @default(0)
  startedAt            DateTime            @default(now())
  endsAt               DateTime?
  stoppedAt            DateTime?
  creditGraceStartedAt DateTime?
  creditGraceEndsAt    DateTime?
  lastError            String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  sessions             AiCampaignSession[]
  chatSettings         AiChatSetting[]
  memories             AiChatMemory[]
  jobs                 AiChatJob[]
  responseLogs         AiResponseLog[]

  @@index([accountId, createdAt])
  @@index([status, endsAt])
  @@index([accountId, status])
  @@index([creditGraceEndsAt])
}

model AiCampaignSession {
  id               String           @id @default(cuid())
  campaignId       String
  campaign         AiCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sessionId        String
  session          TelegramSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  activeSessionId  String?          @unique
  position         Int              @default(0)
  runtimeStatus    String           @default("starting") @db.VarChar(30)
  lastConnectedAt  DateTime?
  lastHeartbeatAt  DateTime?
  lastError        String?
  catchupRequested Boolean          @default(true)
  catchupClaimedAt DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([campaignId, sessionId])
  @@index([campaignId, position])
  @@index([sessionId, createdAt])
  @@index([runtimeStatus, lastHeartbeatAt])
}

model AiChatSetting {
  id         String           @id @default(cuid())
  campaignId String
  campaign   AiCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  accountId  String
  account    ValidatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sessionId  String
  session    TelegramSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  peerId     BigInt
  enabled    Boolean          @default(true)
  config     Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([campaignId, sessionId, peerId])
  @@index([accountId, updatedAt])
}

model AiChatMemory {
  id                String           @id @default(cuid())
  campaignId        String
  campaign          AiCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  accountId         String
  account           ValidatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sessionId         String
  session           TelegramSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  peerId            BigInt
  recipient         Json?
  messages          Json
  conversationState String           @default("active") @db.VarChar(30)
  lastCategory      String?          @db.VarChar(80)
  reengage          Json?
  lastIncomingAt    DateTime?
  lastOutgoingAt    DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([campaignId, sessionId, peerId])
  @@index([campaignId, updatedAt])
  @@index([accountId, updatedAt])
  @@index([sessionId, updatedAt])
}

model AiChatJob {
  id             String           @id @default(cuid())
  campaignId     String
  campaign       AiCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  accountId      String
  account        ValidatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sessionId      String
  session        TelegramSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  peerId         BigInt
  incomingMsgId  BigInt?
  status         String           @default("pending") @db.VarChar(30)
  attempts       Int              @default(0)
  maxAttempts    Int              @default(3)
  isFollowUp     Boolean          @default(false)
  requestPayload Json?
  resultPayload  Json?
  errorCode      String?          @db.VarChar(100)
  errorMessage   String?
  runAfter       DateTime         @default(now())
  claimedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([campaignId, sessionId, incomingMsgId])
  @@index([campaignId, status, runAfter])
  @@index([status, runAfter, createdAt])
  @@index([accountId, createdAt])
  @@index([sessionId, peerId, createdAt])
}

model AiResponseLog {
  id            String           @id @default(cuid())
  campaignId    String
  campaign      AiCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  accountId     String
  account       ValidatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sessionId     String
  session       TelegramSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  jobId         String?
  peerId        BigInt
  incomingMsgId BigInt?
  outgoingMsgId BigInt?
  provider      String           @db.VarChar(30)
  status        String           @db.VarChar(30)
  category      String?          @db.VarChar(80)
  incomingText  String?
  responseText  String?
  isFollowUp    Boolean          @default(false)
  didConvert    Boolean          @default(false)
  errorCode     String?          @db.VarChar(100)
  errorMessage  String?
  providerMeta  Json?
  createdAt     DateTime         @default(now())

  @@index([accountId, createdAt])
  @@index([campaignId, createdAt])
  @@index([sessionId, peerId, createdAt])
  @@index([status, createdAt])
}
